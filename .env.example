# Copy to .env and fill these values from a dedicated Supabase project.
# Migration URL is a project owner/admin connection; runtime URL is a restricted login role.
APP_ENV=production
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-root.crt
SUPABASE_APP_DB_URL=postgresql://inspection_app.PROJECT_REF:URL_ENCODED_APP_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-root.crt
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=public-anon-key
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_TARGET=http://127.0.0.1:8010
PUBLIC_HOSTNAME=inspection.example.com
ACME_EMAIL=ops@example.com
OIDC_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
OIDC_AUDIENCE=authenticated
INSPECTION_AUTH_MODE=oidc
# Optional, dedicated non-production test user for `make smoke-auth-api`.
# Store each value in a mode-0600 file under secrets/; never use a production admin account.
# SUPABASE_E2E_EMAIL_SECRET_FILE=./secrets/supabase_e2e_email
# SUPABASE_E2E_PASSWORD_SECRET_FILE=./secrets/supabase_e2e_password
# Fill only after the Slurm + Isaac Sim compatibility gate is verified.
INSPECTION_EXECUTOR=
ARTIFACT_STORAGE_BACKEND=supabase_s3
SITE_CONFIG_PATH=/app/configs/site.json
MAX_UPLOAD_BYTES=209715200
SUBMISSION_RECOVERY_SECONDS=180
SUBMISSION_ATTEMPT_LIMIT=3
RESULT_IMPORT_RETRY_SECONDS=60

# Supabase Storage S3-compatible endpoint and restricted Auth service identity.
SUPABASE_STORAGE_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# Replace with the region shown in this project's Supabase Storage S3 settings.
SUPABASE_STORAGE_REGION=us-east-1
SUPABASE_STORAGE_BUCKET=inspection-artifacts
SUPABASE_STORAGE_EMAIL_SECRET_FILE=./secrets/supabase_storage_email
SUPABASE_STORAGE_PASSWORD_SECRET_FILE=./secrets/supabase_storage_password

# Optional EAM adapter. Enable only after vendor endpoint and acceptance are approved.
# In Compose, set EAM_API_KEY_SECRET_FILE on the host and use docker-compose.eam.yml.
EAM_ENABLED=false
EAM_BASE_URL=
EAM_SUBMIT_PATH=/api/v1/work-orders
EAM_API_KEY_SECRET_FILE=./secrets/eam_api_key
EAM_TIMEOUT_SECONDS=10

# For Slurm, use docker-compose.slurm.yml after key access and host-key pinning are verified.
SLURM_HOST=
SLURM_USER=
SLURM_IDENTITY_SECRET_FILE=./secrets/id_ed25519
SLURM_KNOWN_HOSTS_SECRET_FILE=./secrets/known_hosts
SLURM_REMOTE_ROOT=
SLURM_PORT=22
SLURM_PARTITION=
SLURM_ACCOUNT=
SLURM_RESULT_SOURCE=
# Compose preflight validates runtime, licensed robot USD, site adapter, and GPU request
# before migration. Supply values only after they have been verified for the target cluster.
ISAAC_SIM_VERSION=
ISAAC_ROBOT_USD_PATH=
ISAAC_SIM_PYTHON=
ISAAC_SIM_ADAPTER=
# Production Isaac jobs must pin the deployed model manifest and artifact.
ISAAC_MODEL_MANIFEST_PATH=
ISAAC_MODEL_MANIFEST_SHA256=
ISAAC_MODEL_ARTIFACT_SHA256=
ISAAC_MODEL_ID=
ISAAC_MODEL_VERSION=
SLURM_ISAAC_GPU_GRES=
SLURM_ISAAC_CPUS=4
SLURM_ISAAC_MEMORY=16G
SLURM_ISAAC_TIME_LIMIT=02:00:00
